<!DOCTYPE html>
<html lang="pt">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Finlytics AI</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

body{
background:#0b0f19;
color:white;
font-family:Arial;
margin:0;
padding:20px;
}

h1{
text-align:center;
}

.dashboard{
display:grid;
grid-template-columns:1fr 1fr;
gap:30px;
margin-top:40px;
}

.card{
background:#151b2e;
padding:20px;
border-radius:10px;
}

button{
background:#4CAF50;
border:none;
padding:10px;
color:white;
cursor:pointer;
margin-top:10px;
}

.result{
margin-top:20px;
font-size:18px;
}

</style>

</head>

<body>

<h1>Finlytics AI — Portfolio Analyzer</h1>

<div class="dashboard">

<div class="card">

<h2>Portfólio</h2>

<p>BTC: 30%</p>
<p>AAPL: 25%</p>
<p>NVDA: 20%</p>
<p>SPY: 25%</p>

<button onclick="calcular()">Calcular Análise</button>

<div class="result" id="resultado"></div>

</div>

<div class="card">

<h2>Distribuição</h2>

<canvas id="grafico"></canvas>

</div>

</div>

<script>

const pesos=[0.30,0.25,0.20,0.25]

const retornos=[0.15,0.12,0.18,0.10]

const riscos=[0.40,0.30,0.35,0.20]

function calcular(){

let retornoEsperado=0
let riscoTotal=0

for(let i=0;i<pesos.length;i++){

retornoEsperado+=pesos[i]*retornos[i]
riscoTotal+=pesos[i]*riscos[i]

}

document.getElementById("resultado").innerHTML=
"Retorno esperado: "+(retornoEsperado*100).toFixed(2)+"%<br>"+
"Risco estimado: "+(riscoTotal*100).toFixed(2)+"%"

}

const ctx=document.getElementById('grafico')

new Chart(ctx,{
type:'pie',
data:{
labels:['BTC','AAPL','NVDA','SPY'],
datasets:[{
data:[30,25,20,25]
}]
}
})

</script>

</body>

</html>
