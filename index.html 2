<!DOCTYPE html>
<html lang="pt">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Finlytics AI</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

body{
background:#0b0f19;
color:white;
font-family:Arial;
margin:0;
padding:20px;
}

h1{
text-align:center;
}

.dashboard{
display:grid;
grid-template-columns:1fr 1fr;
gap:30px;
margin-top:40px;
}

.card{
background:#151b2e;
padding:20px;
border-radius:10px;
}

table{
width:100%;
border-collapse:collapse;
}

td,th{
padding:10px;
border-bottom:1px solid #333;
}

input{
width:80px;
}

button{
background:#4CAF50;
border:none;
padding:10px;
color:white;
cursor:pointer;
margin-top:10px;
}

</style>

</head>

<body>

<h1>Finlytics AI — Portfolio Analyzer</h1>

<div class="dashboard">

<div class="card">

<h2>Carteira</h2>

<table id="portfolioTable">

<tr>
<th>Ativo</th>
<th>%</th>
</tr>

<tr>
<td>BTC</td>
<td>30</td>
</tr>

<tr>
<td>AAPL</td>
<td>25</td>
</tr>

<tr>
<td>NVDA</td>
<td>20</td>
</tr>

<tr>
<td>SPY</td>
<td>25</td>
</tr>

</table>

</div>

<div class="card">

<h2>Distribuição do Portfólio</h2>

<canvas id="portfolioChart"></canvas>

</div>

</div>

<script>

const ctx=document.getElementById('portfolioChart');

const chart=new Chart(ctx,{
type:'pie',
data:{
labels:['BTC','AAPL','NVDA','SPY'],
datasets:[{
data:[30,25,20,25]
}]
}
});

</script>

</body>

  </html>
