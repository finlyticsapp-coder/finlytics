-- ========================================
-- Complete Portfolios Table SQL (Supabase)
-- ========================================

-- 1️⃣ Criar tabela
CREATE TABLE public.portfolios (

id uuid PRIMARY KEY DEFAULT gen_random_uuid(),

created_at timestamp with time zone DEFAULT now(),

name text,

owner_id uuid REFERENCES auth.users(id) ON DELETE CASCADE,

assets jsonb DEFAULT '{}'::jsonb,

performance numeric DEFAULT 0,

benchmark numeric DEFAULT 0,

risk_score numeric DEFAULT 0,

last_updated timestamp with time zone DEFAULT now()

);

-- 2️⃣ Index para performance
CREATE INDEX idx_portfolios_owner
ON public.portfolios(owner_id);

-- 3️⃣ Habilitar Row Level Security
ALTER TABLE public.portfolios ENABLE ROW LEVEL SECURITY;

-- 4️⃣ Políticas de acesso

-- Usuário pode ver seus próprios portfólios
CREATE POLICY "Users can view own portfolios"
ON public.portfolios
FOR SELECT
USING (auth.uid() = owner_id);

-- Usuário pode criar portfólios
CREATE POLICY "Users can create portfolios"
ON public.portfolios
FOR INSERT
WITH CHECK (auth.uid() = owner_id);

-- Usuário pode atualizar portfólios próprios
CREATE POLICY "Users can update portfolios"
ON public.portfolios
FOR UPDATE
USING (auth.uid() = owner_id);

-- Usuário pode deletar portfólios próprios
CREATE POLICY "Users can delete portfolios"
ON public.portfolios
FOR DELETE
USING (auth.uid() = owner_id);
